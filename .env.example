# ============================================================
# BOEG 科研论文投稿进度自动跟踪配置 (.env)
# 复制本文件并重命名为 .env 即可在本地测试（.env 已被 git 忽略，不会泄露）
# ============================================================

# 1. Editorial Manager 登录配置
EM_URL=https://www.editorialmanager.com/boeg/default2.aspx
JOURNAL_NAME=Bulletin of Engineering Geology and the Environment (BOEG)
EM_USERNAME=你的BOEG登录用户名
EM_PASSWORD=你的BOEG登录密码

# 2. 国内发件邮箱配置（推荐 QQ 邮箱 或 163 邮箱，国内直连稳定）
# 填入你的 QQ 邮箱（如 12345678@qq.com）或 163 邮箱（如 xxx@163.com）
SMTP_USER=你的QQ或163邮箱@qq.com
# 注意：这里填邮箱后台生成的【16位 SMTP 授权码】，不是邮箱登录密码！
SMTP_PASS=你的16位邮箱SMTP授权码

# 3. 接收进展通知的目标邮箱（填你的 Google 邮箱，支持逗号分隔多个收件邮箱）
NOTIFY_TO=你的谷歌邮箱@gmail.com

# 4. 可选高级配置（留空即可自动识别）
# 若使用高校邮箱或其他企业邮箱，可手动指定 SMTP 服务器和端口：
SMTP_HOST=
SMTP_PORT=465
# 你的 GitHub Pages 看板网址（配置好后填入，邮件里会附带一键查看看板按钮）
DASHBOARD_URL=
# 若使用公开 GitHub 仓库且不想在网页上公开论文完整标题，可设为 true（邮件中仍显示完整标题）
HIDE_MANUSCRIPT_TITLE=false
# 首次接入成功时是否发送一封确认邮件（默认 true，方便确认自动监控已生效）
NOTIFY_ON_FIRST_RUN=true
